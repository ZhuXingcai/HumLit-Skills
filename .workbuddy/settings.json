{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .workbuddy/hooks/_launcher.py session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .workbuddy/hooks/_launcher.py session-start.py",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .workbuddy/hooks/_launcher.py session-start.py",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .workbuddy/hooks/_launcher.py inject-workflow-state.py",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python -X utf8 .workbuddy/hooks/_launcher.py inject-subagent-context.py",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
